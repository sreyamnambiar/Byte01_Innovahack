# ============================================================
# DarkTrust – Zero Trust Security Platform
# .gitignore
# ============================================================

# ============================================================
# ENVIRONMENT & SECRETS — NEVER COMMIT THESE
# ============================================================
.env
.env.local
.env.*.local
.env.production
*.pem
*.key
*.crt
secrets/

# ============================================================
# PYTHON / BACKEND
# ============================================================

# Virtual environments
.venv/
venv/
ENV/
env/
.Python

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
MANIFEST

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytest.ini

# PyCharm
.idea/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Alembic — keep versions, ignore auto-generated pyc
backend/alembic/versions/__pycache__/

# ============================================================
# NODE / FRONTEND
# ============================================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite build output
frontend/dist/
frontend/dist-ssr/
frontend/.vite/

# Local Netlify, Vercel
.netlify/
.vercel/

# TypeScript
*.tsbuildinfo

# Optional npm cache
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Yarn
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ============================================================
# OPERATING SYSTEM
# ============================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# ============================================================
# EDITORS & IDEs
# ============================================================

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains
.idea/
*.iml
*.iws
*.ipr
out/

# Vim
*.swp
*.swo
*.vim

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============================================================
# LOGS
# ============================================================
logs/
*.log
*.log.*

# ============================================================
# DOCKER (for future use)
# ============================================================
docker-compose.override.yml

# ============================================================
# TESTING ARTIFACTS
# ============================================================
.pytest_cache/
test-results/
playwright-report/

# ============================================================
# MISC
# ============================================================
*.bak
*.tmp
*.temp
.sass-cache/
connect.lock
typings/
