# ============================================================
# DarkTrust – Zero Trust Security Platform
# Backend Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------
APP_NAME="DarkTrust"
APP_VERSION="1.0.0"
APP_DESCRIPTION="Zero Trust Security Platform for Decentralized APIs"
DEBUG=True
ENVIRONMENT=development

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/dbname

DATABASE_URL=postgresql+asyncpg://postgres:victory123@localhost:5432/darktrust

# Sync URL used by Alembic migrations only
DATABASE_SYNC_URL=postgresql://victory123@localhost:5432/darktrust

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------
JWT_SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY_256_BITS
JWT_ALGORITHM=HS256
# Access token expiry in minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token expiry in days
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------
# Number of rounds for bcrypt hashing
BCRYPT_ROUNDS=12
# Rate limiting: max requests per minute per IP
RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------
LOG_LEVEL=INFO
# Options: json | text
LOG_FORMAT=json

# ------------------------------------------------------------
# API
# ------------------------------------------------------------
API_V1_PREFIX=/api/v1
